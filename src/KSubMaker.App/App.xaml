<Application x:Class="KSubMaker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:KSubMaker.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ================= converters ================= -->
            <conv:BytesToStringConverter x:Key="BytesToString" />
            <conv:SecondsToTimeConverter x:Key="SecondsToTime" />
            <conv:JobStatusToTextConverter x:Key="JobStatusToText" />
            <conv:JobStageToTextConverter x:Key="JobStageToText" />
            <conv:JobStatusToBrushConverter x:Key="JobStatusToBrush" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBooleanConverter x:Key="InverseBoolean" />
            <conv:PercentToTextConverter x:Key="PercentToText" />
            <conv:EmptyToDashConverter x:Key="EmptyToDash" />

            <!-- ================= base styles ================= -->
            <Style TargetType="TextBlock" x:Key="LabelText">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style TargetType="TextBlock" x:Key="HintText">
                <Setter Property="Foreground" Value="#666666" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <Style TargetType="TextBlock" x:Key="SectionHeader">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style TargetType="Button" x:Key="CommandButton">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Style TargetType="CheckBox" x:Key="OptionCheckBox">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,16,0" />
            </Style>

            <Style TargetType="TextBox" x:Key="NumberBox">
                <Setter Property="Width" Value="90" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="Padding" Value="4,3" />
            </Style>

            <Style TargetType="ComboBox" x:Key="OptionCombo">
                <Setter Property="MinWidth" Value="260" />
                <Setter Property="Padding" Value="6,3" />
            </Style>

            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Padding" Value="10" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
