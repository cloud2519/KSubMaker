<Window x:Class="KSubMaker.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KSubMaker.App.Resources"
        Title="{x:Static res:Strings.LogWindowTitle}"
        Height="640"
        Width="1080"
        MinHeight="360"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic"
        FontSize="12">

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top" Padding="12,10" Background="#F5F6F8">
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.OpenLogFolderButton}"
                        Command="{Binding OpenLogFolderCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.Refresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource CommandButton}" />

                <CheckBox Content="{x:Static res:Strings.LogAutoRefreshLabel}"
                          IsChecked="{Binding AutoRefresh}"
                          Style="{StaticResource OptionCheckBox}"
                          Margin="10,0,16,0" />

                <TextBlock Text="{x:Static res:Strings.LogFileLabel}" Style="{StaticResource LabelText}" />
                <TextBlock Text="{Binding CurrentFile}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="420" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="12,6" Background="#F5F6F8">
            <TextBlock Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusMessage}" />
        </Border>

        <TextBox x:Name="LogTextBox"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas, D2Coding, Malgun Gothic"
                 FontSize="11"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Margin="12,8,12,8"
                 Padding="6"
                 Background="#1E1E1E"
                 Foreground="#DCDCDC" />

    </DockPanel>
</Window>
