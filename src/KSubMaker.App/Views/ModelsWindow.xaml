<Window x:Class="KSubMaker.App.Views.ModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KSubMaker.App.Resources"
        Title="{x:Static res:Strings.ModelsWindowTitle}"
        Height="600"
        Width="1120"
        MinHeight="420"
        MinWidth="880"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Malgun Gothic"
        FontSize="12">

    <DockPanel LastChildFill="True">

        <!-- ======================= command bar ======================= -->
        <Border DockPanel.Dock="Top" Padding="12,10" Background="#F5F6F8">
            <WrapPanel Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.DownloadButton}"
                        Command="{Binding DownloadCommand}"
                        Style="{StaticResource CommandButton}"
                        FontWeight="SemiBold" />
                <Button Content="{x:Static res:Strings.PauseDownloadButton}"
                        Command="{Binding PauseDownloadCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.ResumeDownloadButton}"
                        Command="{Binding DownloadCommand}"
                        Style="{StaticResource CommandButton}" />

                <Rectangle Width="1" Height="24" Fill="#D5D8DD" Margin="4,0,10,0" VerticalAlignment="Center" />

                <Button Content="{x:Static res:Strings.DeleteModelButton}"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.VerifyModelButton}"
                        Command="{Binding VerifyCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.OpenModelFolderButton}"
                        Command="{Binding OpenModelFolderCommand}"
                        Style="{StaticResource CommandButton}" />
                <Button Content="{x:Static res:Strings.Refresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource CommandButton}" />

                <ProgressBar Width="120"
                             Height="6"
                             IsIndeterminate="True"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Border>

        <!-- ======================= footer ======================= -->
        <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#F5F6F8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}" />

                <Button Grid.Column="1"
                        Content="{x:Static res:Strings.Close}"
                        Style="{StaticResource CommandButton}"
                        IsCancel="True" />
            </Grid>
        </Border>

        <!-- ======================= selected model detail ======================= -->
        <Border DockPanel.Dock="Bottom" Padding="12,6" BorderBrush="#E0E2E6" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static res:Strings.ModelDescriptionLabel}"
                           Style="{StaticResource LabelText}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedModel.Description}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="900"
                           ToolTip="{Binding SelectedModel.Description}" />
            </StackPanel>
        </Border>

        <!-- ======================= model grid ======================= -->
        <DataGrid ItemsSource="{Binding Models}"
                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  RowHeight="28"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="12,8,12,4">

            <DataGrid.Columns>

                <!-- 이름 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ModelColumnName}" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <Border Background="#E3F0E3"
                                        CornerRadius="3"
                                        Padding="5,1"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{x:Static res:Strings.ModelRecommendedMark}"
                                               FontSize="10"
                                               Foreground="#1F7A33" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 종류 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ModelColumnKind}"
                                    Binding="{Binding KindText}"
                                    Width="90" />

                <!-- 상태 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ModelColumnState}"
                                    Binding="{Binding StateText}"
                                    Width="100" />

                <!-- 크기 -->
                <DataGridTextColumn Header="{x:Static res:Strings.ModelColumnSize}"
                                    Binding="{Binding SizeBytes, Converter={StaticResource BytesToString}}"
                                    Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 예상 VRAM -->
                <DataGridTextColumn Header="{x:Static res:Strings.ModelColumnVram}"
                                    Binding="{Binding VramText}"
                                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 진행률 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ModelColumnProgress}" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center" ToolTip="{Binding ProgressDetail}">
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Height="16"
                                             Value="{Binding DownloadPercent, Mode=OneWay}" />
                                <TextBlock Text="{Binding DownloadPercent, Converter={StaticResource PercentToText}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 라이선스 -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ModelColumnLicense}" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding License}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding License}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
