<Window x:Class="KSubMaker.App.Views.SubtitleSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:KSubMaker.App.Resources"
        Title="{x:Static res:Strings.SubtitleSourceDialogTitle}"
        Height="380"
        Width="560"
        MinHeight="300"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FontFamily="Malgun Gothic"
        FontSize="12">

    <DockPanel LastChildFill="True" Margin="14">

        <TextBlock DockPanel.Dock="Top"
                   x:Name="MessageText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />

        <TextBlock DockPanel.Dock="Top"
                   Text="{x:Static res:Strings.SubtitleSourceHint}"
                   Style="{StaticResource HintText}"
                   Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="{x:Static res:Strings.Ok}"
                    Style="{StaticResource CommandButton}"
                    IsDefault="True"
                    FontWeight="SemiBold"
                    Click="OnAccept" />

            <!-- IsCancel gives Esc and the title-bar X the same meaning as the button: change
                 nothing. Unlike SettingsWindow there is no view model assigning DialogResult here,
                 so letting WPF assign it is safe. -->
            <Button Content="{x:Static res:Strings.Cancel}"
                    Style="{StaticResource CommandButton}"
                    IsCancel="True" />
        </StackPanel>

        <ListBox x:Name="OptionList"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="OnAccept">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Hint}"
                                   Style="{StaticResource HintText}"
                                   Visibility="{Binding Hint, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
